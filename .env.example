# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials (see PRD Security Requirements).

# --- MariaDB ---
MYSQL_ROOT_PASSWORD=changeme-root-password
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=changeme-nextcloud-db-password

# --- Nextcloud admin bootstrap ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme-admin-password
NEXTCLOUD_TRUSTED_DOMAINS=localhost

# --- CampusCloud CLI ---
# Host port Nextcloud is published on.
CAMPUSCLOUD_HTTP_PORT=8080
# Directory (on the host) where campuscloud stores backups.
CAMPUSCLOUD_BACKUP_DIR=./backups
