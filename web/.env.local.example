# Copy to .env.local for local development (`npm run dev`), or set as a
# Vercel Project environment variable before deploying.
#
# This only pre-fills the API URL field on the login screen — it is NOT a
# secret and is safe to bake into the client bundle (NEXT_PUBLIC_*
# variables are). The API token itself is always entered by the operator
# at login time and stored only in their browser.
NEXT_PUBLIC_API_URL=https://campuscloud.example.edu:9090
